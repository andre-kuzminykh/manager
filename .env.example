# =============================================================================
# Humanoid CEO Brain — .env example
# -----------------------------------------------------------------------------
# Полный список env-переменных (источник: app/config.py). Значения справа —
# ДЕФОЛТЫ из кода. Секреты оставлены пустыми. Флаги *_ENABLED по умолчанию
# false на чистом инстансе — в проде оператор включает нужные.
# Группировка соответствует фичам из PRD.md.
# =============================================================================

# --- App / core ---
APP_ENV=development
LOG_LEVEL=INFO
WATCHDOG_MAX_SILENCE_SECONDS=600
SECRETS_ENCRYPTION_KEY=                 # Fernet key (base64 urlsafe 32 bytes) — for OAuth token storage. SECRET.

# --- Slack (main bot) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...                # required for Socket Mode
SLACK_SIGNING_SECRET=                   # only in HTTP mode
ADMIN_SLACK_USER_IDS=                   # comma-separated

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/slack_tasks

# --- LLM providers ---
# LLM_PROVIDER: "auto" (OpenAI if key set, else Anthropic) | "openai" | "anthropic" | "none"
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_DATE_MODEL=gpt-4o
OPENAI_TITLE_MODEL=gpt-4o
OPENAI_DEDUP_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large
ENTITY_MATCH_CRITIC_MODEL=gpt-4o
DEDUP_FAST_PATH=true

# =============================================================================
# NOTE TAKER  (Zoom + Fireflies → summary/tasks)  — pipeline runs in ops/zoom_fireflies_runner
# =============================================================================

# --- Zoom ingest ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SECRET_TOKEN=
ZOOM_API_BASE=https://api.zoom.us/v2
ZOOM_OAUTH_URL=https://zoom.us/oauth/token
ZOOM_AUDIO_DIR=/app/zoom
ZOOM_DOCS_FOLDER_ID=                    # Shared Drive folder for meeting Docs
ZOOM_AUDIO_MAX_BYTES=209715200          # 200 MiB
ZOOM_REALTIME_ENABLED=false
ZOOM_POLL_INTERVAL_SECONDS=60
ZOOM_POLL_BATCH_SIZE=10
ZOOM_REQUIRED_EMAIL=                    # only process meetings hosted by this operator email
ZOOM_REQUIRED_EMAIL_STRICT_HOST=false   # FR-CR-05-173: only post if operator actually joined
ZOOM_POST_TASK_CARDS_TIMEOUT_SECONDS=120

# --- Zoom bilingual restoration (FR-CR-05-170) ---
# When a meeting is mixed RU/EN, Zoom's own transcript can drop one language.
# If enabled: detect bilingual → re-transcribe with Whisper → reconcile/merge.
ZOOM_BILINGUAL_RESTORATION_ENABLED=false
ZOOM_BILINGUAL_DETECTOR_MODEL=gpt-4o-mini
ZOOM_BILINGUAL_RECONCILER_MODEL=gpt-4o
ZOOM_BILINGUAL_WHISPER_MODEL=whisper-1
ZOOM_BILINGUAL_RECONCILE_BATCH_INPUT_CHARS=30000
ZOOM_BILINGUAL_RECONCILE_MAX_TOKENS_PER_BATCH=16384
ZOOM_FALLBACK_WHISPER_ENABLED=true      # fall back to Whisper if Zoom transcript missing/corrupt
ZOOM_FALLBACK_WHISPER_MODEL=whisper-1

# --- Native transcripts first (FR-NT-TR, SPEC_NATIVE_TRANSCRIPT_v0.1) ---
# Prefer the service's own transcript over Whisper. When on, the native
# transcript is used as PRIMARY and Whisper is skipped; if native is
# missing/empty/shorter than NATIVE_TRANSCRIPT_MIN_CHARS, the full Whisper
# path runs as fallback. Zoom still runs the bilingual English pass on top.
# Default false ⇒ unchanged Whisper-first behaviour.
ZOOM_PREFER_NATIVE_TRANSCRIPT=false       # Zoom: use VTT as primary
FIREFLIES_PREFER_NATIVE_TRANSCRIPT=false  # Fireflies: use GraphQL sentences as primary
NATIVE_TRANSCRIPT_MIN_CHARS=100           # below this, native is treated as a fragment → Whisper

# --- Fireflies ingest ---
FIREFLIES_API_TOKEN=
FIREFLIES_API_URL=https://api.fireflies.ai/graphql
FIREFLIES_AUDIO_DIR=/app/fireflies
FIREFLIES_DOCS_FOLDER_ID=
FIREFLIES_REALTIME_ENABLED=false
FIREFLIES_POLL_INTERVAL_SECONDS=60
FIREFLIES_POLL_BATCH_SIZE=20
FIREFLIES_WHISPER_MODEL=gpt-4o-transcribe-diarize
FIREFLIES_SUMMARY_MODEL=gpt-5.5
FIREFLIES_SHORT_SUMMARY_MODEL=gpt-5.5
FIREFLIES_TASKS_MODEL=gpt-5.5
FIREFLIES_TASKS_REASONING_EFFORT=high
FIREFLIES_AUDIO_MAX_BYTES=209715200     # 200 MiB
MIN_MEETING_SECONDS=300                 # skip recordings shorter than this

# --- Calendar match (title canonicalization) ---
CALENDAR_MATCH_ENABLED=false
CALENDAR_MATCH_WINDOW_MINUTES=30
CALENDAR_APPS_SCRIPT_URL=
CALENDAR_APPS_SCRIPT_SHARED_TOKEN=
GOOGLE_CALENDAR_ID=primary              # comma-separated for multi-calendar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Counterparty matching (vector + critic catalog) ---
COUNTERPARTY_MATCH_V2_MODE=off          # "on" → vector+critic resolver; "off" → legacy
COUNTERPARTY_MATCH_V2_K=20
CATALOG_DATABASE_URL=                   # pgvector DB holding entity_catalog_staging
COUNTERPARTY_AUTOENROLL_ENABLED=false

# --- FR entity resolver (FR-EC-CRITIC, SPEC_ENTITY_CRITIC) ---
# Canonicalise meeting entity mentions against Viktor's CRM (his n8n MCP dump,
# ~1422 rows leaned to ~45K tokens, cached), one reasoning-model pass. No
# vector. Default off; shadow logs decisions without applying them.
ENTITY_FR_RESOLVER_ENABLED=false
ENTITY_FR_RESOLVER_SHADOW=false
ENTITY_FR_MCP_URL=                      # Viktor's humanoid_fr MCP endpoint
ENTITY_FR_RESOLVER_MODEL=gpt-5.5        # strong reasoning model for the one-pass canonicaliser (high effort)
ENTITY_FR_CATALOG_TTL_SECONDS=3600      # refetch his dump at most this often
ENTITY_FR_MAX_CONTEXT_TOKENS=30000      # shard the CRM so each map-call stays under this
ENTITY_FR_SHARD_WORKERS=4               # parallel map-calls
ENTITY_FR_MIN_CONFIDENCE=0.7            # apply a pick to summary/tasks only at/above this
COUNTERPARTY_RESOLVE_BATCH_SIZE=20
COUNTERPARTY_RESOLVE_MAX_WORKERS=5

# --- Distribution: meeting webhook (FR-CR-05-160) ---
# POST each meeting summary (Zoom + Fireflies) to an external webhook (n8n).
# EMPTY → disabled. Fires only AFTER a non-empty short_summary. MUST be set
# wherever ops.zoom_fireflies_runner runs. Payload = summary + participants +
# tasks_count (NOT the task list / transcript). See app/services/meeting_webhook.py.
MEETING_WEBHOOK_URL=
SLACK_MEETING_CHANNEL_ID=               # Slack channel for meeting summaries (slack_mirror)

# =============================================================================
# MEETING AGENDA  (FR-CR-05-165)  — daemon in app/main.py
# =============================================================================
AGENDA_ENABLED=false
AGENDA_SOURCE=calendar                  # "calendar" | "zoom_pattern"
AGENDA_SLACK_TARGET_CHANNEL_ID=
AGENDA_SLACK_BOT_TOKEN=                 # optional separate token
AGENDA_TICK_INTERVAL_SECONDS=60
AGENDA_LEAD_TIME_MINUTES=10
AGENDA_WINDOW_MINUTES=1
AGENDA_LOOKBACK_DAYS=90
AGENDA_MIN_PRIOR_MEETINGS=2
AGENDA_COMPOSE_MODEL=                   # blank → default summary model

# =============================================================================
# COUNTERPARTY BRIEFS  (FR-CR-05-168)  — daemon in app/main.py
# =============================================================================
COUNTERPARTY_BRIEFS_ENABLED=false
COUNTERPARTY_BRIEFS_SLACK_TARGET_CHANNEL_ID=
COUNTERPARTY_BRIEFS_LOOKAHEAD_DAYS=7
COUNTERPARTY_BRIEFS_TICK_INTERVAL_SECONDS=1800
COUNTERPARTY_BRIEFS_LLM_BUDGET_USD=2.0
COUNTERPARTY_BRIEFS_CACHE_TTL_DAYS=180
COUNTERPARTY_BRIEFS_MAX_BENEFICIARIES=5
COUNTERPARTY_BRIEFS_RESEARCH_MODEL=o4-mini-deep-research
COUNTERPARTY_BRIEFS_EXTRACT_MODEL=

# =============================================================================
# CEO BRAIN BOT  (FR-CB2-*)  — chat agent, listener in app/main.py
# =============================================================================
CEO_BRAIN_ENABLED=false
CEO_BRAIN_ARCHIVE_ONLY=false
CEO_BRAIN_ANTHROPIC_API_KEY=
CEO_BRAIN_MODEL=claude-sonnet-4-6
CEO_BRAIN_SLACK_APP_TOKEN=
CEO_BRAIN_SLACK_BOT_TOKEN=
CEO_BRAIN_SLACK_USER_TOKEN=
CEO_BRAIN_SIGNING_SECRET=
CEO_BRAIN_ARCHIVE_DIR=/var/lib/manager/slack-archive
CEO_BRAIN_ARCHIVE_CHANNELS=             # whitelist, comma-separated
CEO_BRAIN_ALLOWED_USERS=                # who may use write tools
CEO_BRAIN_THREAD_CONTEXT_MSGS=10
CEO_BRAIN_MAX_RUN_COST_USD=1.0          # NOTE: spec NFR-CB2-C.2 says $5 — divergence, see AUDIT.md
CEO_BRAIN_JSONL_RETENTION_DAYS=365
MCP_SERVERS=                            # JSON config of external MCP servers

# =============================================================================
# TASK VECTOR  (FR-TV-*)  — search / Q&A / NL task updates via CEO Brain
# =============================================================================
TASK_VECTOR_ENABLED=false               # P5: search + Q&A (read-only)
TASK_VECTOR_WRITES_ENABLED=false        # P6: NL status/due/owner updates (code exists, gated)
TASK_VECTOR_DATABASE_URL=               # pgvector DB for task/team embeddings
TASK_VECTOR_MODEL=text-embedding-3-large
TASK_VECTOR_K=10
TASK_VECTOR_TAU_HIGH=0.45
TASK_VECTOR_TAU_LOW=0.30
TASK_VECTOR_DELTA=0.05
TASK_VECTOR_IMMEDIATE_UPSERT=false
TASK_MCP_SERVER_ENABLED=false

# =============================================================================
# TASK TRACKER  (task lifecycle: ingest → drafts → cards → sync)
# =============================================================================
# --- Telegram ingest ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_SOURCE_DATABASE_URL=
TELEGRAM_SOURCE_VIEW=humanoid_tg_chats_readonly
TELEGRAM_INGEST_BATCH_SIZE=200
TELEGRAM_ADMIN_USER_IDS=                # comma-separated
# --- Slack ingest ---
SLACK_INGEST_ENABLED=false
# --- Supabase view poller (TG source) ---
VIEW_REALTIME_ENABLED=false
VIEW_POLL_INTERVAL_SECONDS=30
VIEW_POLL_BATCH_SIZE=500
# --- intent / workload ---
INTENT_CONFIDENCE_HIGH=0.75
INTENT_CONFIDENCE_LOW=0.40
CONTEXT_WINDOW_BEFORE=10
ALLOWED_OWNERS=[]
EMPLOYEE_REFRESH_TTL_SECONDS=86400
WORKLOAD_MINUTES_PER_DAY=360
WORKLOAD_DEFAULT_TASK_MINUTES=120

# =============================================================================
# GOOGLE WORKSPACE  (OAuth + Sheets + Tasks + service account)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback
GOOGLE_SERVICE_ACCOUNT_JSON=            # inline JSON, OR ↓ path
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Main
GOOGLE_TEAM_SHEETS_SPREADSHEET_ID=
GOOGLE_TEAM_SHEETS_TAB_NAME=Team
GOOGLE_TASKS_DEFAULT_TASKLIST_ID=@default
GOOGLE_TASKS_PULL_INTERVAL_SECONDS=60

# --- Sheet sync (tasks → Google Sheet) ---
SHEET_SYNC_ENABLED=false
SHEET_SYNC_SPREADSHEET_ID=
SHEET_SYNC_TAB_TITLE=ceo_brain_tasks
SHEET_SYNC_ALL_DIRECTIONS=true
SHEET_SYNC_INTERVAL_SECONDS=300
SHEET_SYNC_TIMEZONE=Europe/London
SHEET_SYNC_MAX_ROWS_PER_TAB=5000
SHEET_POLL_INTERVAL_SECONDS=60
# --- FR-SS — bidirectional bridge (Sheet as edit interface, DB = truth) ---
# Off by default. Activate only AFTER `python -m ops.sheet_sync_bridge --migrate`
# has stamped DeveloperMetadata gs_row_uuid onto existing rows and a shadow-tab
# smoke pass. Do NOT run alongside the legacy app/sync/sheets.py writer.
SHEET_SYNC_BRIDGE_ENABLED=false
SHEET_SYNC_BRIDGE_MAX_DELETE_PCT=0.2     # mass-delete guard threshold (FR-SS-SAFE-2)

# --- Counterparties status/outreach sheets ---
COUNTERPARTIES_STATUS_SHEET_ID=
COUNTERPARTIES_STATUS_TAB_NAME=Status outreach
COUNTERPARTIES_OUTREACH_SHEET_ID=
COUNTERPARTIES_OUTREACH_TAB_NAMES=Outreach
COUNTERPARTIES_TARGETS_SHEET_ID=
COUNTERPARTIES_TARGETS_TAB_NAMES=Investor Targets
COUNTERPARTIES_POLL_INTERVAL_SECONDS=300
