# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...            # required for Socket Mode
SLACK_SIGNING_SECRET=               # only needed in HTTP mode

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/slack_tasks

# --- LLM ---
# Provider selection: "auto" (default; picks OpenAI if OPENAI_API_KEY set,
# else Anthropic), "openai", "anthropic", or "none" (rules only).
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_TASKS_DEFAULT_TASKLIST_ID=@default

# --- Integrations ---
# FR-CR-05-160 — POST each meeting summary (Zoom + Fireflies) to an
# external webhook (consumer: n8n). EMPTY → webhook disabled (no-op),
# nothing is sent. The call fires only AFTER a non-empty short_summary
# is produced, from the Zoom/Fireflies pipeline container — so this
# MUST be set wherever `ops.zoom_fireflies_runner` runs, not only on
# the main bot. Payload = summary + participants + tasks_count (NOT the
# task list or transcript). See app/services/meeting_webhook.py.
MEETING_WEBHOOK_URL=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# Confidence thresholds for passive intent detection
INTENT_CONFIDENCE_HIGH=0.75
INTENT_CONFIDENCE_LOW=0.40

# Context retrieval
CONTEXT_WINDOW_BEFORE=10

# Encryption key for OAuth token storage (Fernet key, base64 urlsafe 32 bytes)
SECRETS_ENCRYPTION_KEY=
